# SENIOR ENGINEER CONFIGURATION
# Optimized for cPanel/Apache React Deployments

# 1. Stability & Standards
Options -MultiViews -Indexes
DirectoryIndex index.html

# Set default content-type & charset for HTML pages to avoid Accept header negotiation failures (406)
AddDefaultCharset UTF-8

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 2. Handle Known Spam/Unwanted URLs with 410 Gone Status (DO NOT redirect to homepage)
  RewriteCond %{REQUEST_URI} ^/need-protection-money-properties-vip-escort-services/?$ [NC]
  RewriteRule ^ - [R=410,L]

  # 3. Canonical Host & HTTPS Redirection (301 Permanent Redirect)
  # Redirect HTTP to HTTPS and non-www (isisecurity.in) to www.isisecurity.in
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.isisecurity\.in$ [NC]
  RewriteRule ^(.*)$ https://www.isisecurity.in/$1 [L,R=301]

  # 4. SPA Routing (React Router)
  RewriteRule ^index\.html$ - [L]

  # Optimization: Don't rewrite known static assets
  RewriteCond %{REQUEST_URI} !\.(js|css|svg|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot|map|json|xml|txt)$ [NC]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Fallback for 406 Not Acceptable to index.html with 200 OK
ErrorDocument 406 /index.html
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  # 5. Critical Cache Control
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache Assets aggressively
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # 6. Security (Safe Mode)
  Header set Access-Control-Allow-Origin "https://www.isisecurity.in"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "frame-ancestors 'self';"
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/xml .xml
</IfModule>
